# ECONEX NOVA - Production Environment Configuration
# Copy this to .env for production deployment

# === SERVER ===
NODE_ENV=production
PORT=3000

# === FRONTEND ===
# Set this to your frontend URL (Render static site URL)
FRONTEND_URL=https://your-frontend-name.onrender.com

# === AI PROVIDER ===
# Use "mock" for demo/testing (free)
# Use "bedrock" for real AI vision analysis (requires AWS)
AI_PROVIDER=mock

# === AWS BEDROCK (Optional - only if AI_PROVIDER=bedrock) ===
# Get these from AWS Console → IAM → Create User with Bedrock access
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# === FILE UPLOAD ===
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png

# === RENDER DEPLOYMENT NOTES ===
#
# 1. Set these environment variables in Render Dashboard:
#    - NODE_ENV=production
#    - AI_PROVIDER=mock (or bedrock if using AWS)
#    - FRONTEND_URL=https://your-frontend-name.onrender.com
#
# 2. If using Bedrock AI:
#    - Add AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#    - Add BEDROCK_MODEL_ID
#
# 3. PORT is automatically set by Render (don't override)
#
# 4. RENDER_EXTERNAL_URL is automatically set by Render
#    (used for server logging)
