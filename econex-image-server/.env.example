# ECONEX NOVA - Development Environment Configuration
# Copy this to .env for local development

# === SERVER ===
NODE_ENV=development
PORT=3000

# === FRONTEND ===
# Local development frontend URL
FRONTEND_URL=http://localhost:5173

# === AI PROVIDER ===
# Use "mock" for demo/testing (no API keys needed)
# Use "bedrock" for real AI vision analysis (requires AWS credentials)
AI_PROVIDER=mock

# === AWS BEDROCK (Optional - only if AI_PROVIDER=bedrock) ===
# Get these from AWS Console → IAM → Create User with Bedrock access
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# === FILE UPLOAD ===
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png

# === DEVELOPMENT NOTES ===
#
# 1. Install dependencies: npm install
# 2. Copy this file: cp .env.example .env
# 3. Start server: npm start
# 4. Open frontend: http://localhost:5173 (or use Live Server on ai-main/image.html)
#
# For production deployment, see .env.production.example
